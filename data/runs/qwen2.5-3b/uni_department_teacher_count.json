  "prompt": "Rewrite the following MySQL 8.4 SELECT query for efficiency. Preserve output column names, values, duplicates, NULL behavior and the specified row order for EVERY state allowed by the schema. Do not add indexes or change the schema. Return only one SELECT statement, without markdown or explanation. If no safe improvement is available, return the original query.\nCREATE TABLE departments(id INTEGER PRIMARY KEY, name VARCHAR(80) NOT NULL UNIQUE, faculty VARCHAR(80) NOT NULL, budget DECIMAL(12,2) NOT NULL, CHECK(budget >= 0))\nCREATE TABLE teachers(id INTEGER PRIMARY KEY, name VARCHAR(80) NOT NULL, department_id INTEGER NOT NULL, title VARCHAR(30) NOT NULL, hired_at DATE NOT NULL, salary DECIMAL(10,2) NULL, FOREIGN KEY(department_id) REFERENCES departments(id), CHECK(title IN ('assistant','lecturer','senior_lecturer','professor')), CHECK(salary IS NULL OR salary >= 0))\nCREATE TABLE students(id INTEGER PRIMARY KEY, name VARCHAR(80) NOT NULL, email VARCHAR(120) NOT NULL UNIQUE, department_id INTEGER NOT NULL, enrolled_at DATE NOT NULL, status VARCHAR(20) NOT NULL, birth_date DATE NULL, FOREIGN KEY(department_id) REFERENCES departments(id), CHECK(status IN ('active','graduated','expelled','leave')))\nCREATE TABLE semesters(id INTEGER PRIMARY KEY, name VARCHAR(20) NOT NULL UNIQUE, starts_on DATE NOT NULL, ends_on DATE NOT NULL, CHECK(ends_on > starts_on))\nCREATE TABLE courses(id INTEGER PRIMARY KEY, code VARCHAR(16) NOT NULL UNIQUE, title VARCHAR(120) NOT NULL, department_id INTEGER NOT NULL, credits INTEGER NOT NULL, FOREIGN KEY(department_id) REFERENCES departments(id), CHECK(credits BETWEEN 1 AND 30))\nCREATE TABLE enrollments(id INTEGER PRIMARY KEY, student_id INTEGER NOT NULL, course_id INTEGER NOT NULL, semester_id INTEGER NOT NULL, teacher_id INTEGER NOT NULL, enrolled_on DATE NOT NULL, status VARCHAR(20) NOT NULL, FOREIGN KEY(student_id) REFERENCES students(id), FOREIGN KEY(course_id) REFERENCES courses(id), FOREIGN KEY(semester_id) REFERENCES semesters(id), FOREIGN KEY(teacher_id) REFERENCES teachers(id), UNIQUE(student_id, course_id, semester_id), CHECK(status IN ('enrolled','passed','failed','dropped')))\nCREATE TABLE grades(id INTEGER PRIMARY KEY, enrollment_id INTEGER NOT NULL UNIQUE, score DECIMAL(5,2) NULL, grade_letter VARCHAR(2) NULL, graded_on DATE NULL, FOREIGN KEY(enrollment_id) REFERENCES enrollments(id), CHECK(score IS NULL OR (score >= 0 AND score <= 100)), CHECK(grade_letter IS NULL OR grade_letter IN ('A','B','C','D','E','F')))\nQUERY:\nSELECT d.id, COUNT(t.id) AS n FROM departments d LEFT JOIN teachers t ON t.department_id=d.id GROUP BY d.id ORDER BY d.id",
